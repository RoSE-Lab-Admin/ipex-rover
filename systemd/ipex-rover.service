[Unit]
Description=IPEX Rover ROS 2 Bringup
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ipex-rp5
WorkingDirectory=/home/ipex-rp5/ipex_ws

ExecStart=/home/ipex-rp5/ipex_ws/scripts/start_rover.sh

Restart=on-failure
RestartSec=5

KillSignal=SIGINT
TimeoutStopSec=10

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
