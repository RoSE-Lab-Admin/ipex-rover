<?xml version="1.0" ?>
<!-- Sensor frames (no meshes), fixed to the CAD sensor links in ipex.xacro
     (IMU_1, D435_camera_front_1, D435_camera_rear_1). Offsets are the mesh box
     centers in those links (V1.3 export, 2026-11-03), so the frames follow the
     CAD when it is re-exported. In base_link: IMU (0.055, -0.091, 0.375) =
     front-right of center (IMU_1 is turned 180 deg in ipex.xacro: the CAD
     avionics box is rotated); front camera (0.282, -0.112, 0.201) = front-right;
     rear camera (-0.283, 0.112, 0.201) = rear-left. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sensor_frame" params="name parent xyz rpy">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- UM7 IMU (frame_id imu_link): board center. The driver publishes body
       FLU (orientation_in_robot_frame), so rpy 0 assumes the board's x arrow
       points to the front-arm end (+x). IMU_1 is turned 180 deg, so yaw ${pi}
       here keeps imu_link aligned with base_link; use 0 if the arrow points
       to the rear. -->
  <xacro:sensor_frame name="imu_link" parent="IMU_1"
                      xyz="0.045 0.0 -0.0032" rpy="0 0 ${pi}"/>

  <!-- Intel RealSense D435 bodies (box centers), facing out of each end.
       The RealSense driver's own camera_link sits on the left imager, not the
       body center; attach it here with a fixed offset when the cameras go in. -->
  <xacro:sensor_frame name="front_camera_link" parent="D435_camera_front_1"
                      xyz="0.0325 -0.1121 0.0125" rpy="0 0 0"/>
  <xacro:sensor_frame name="rear_camera_link" parent="D435_camera_rear_1"
                      xyz="-0.0325 0.1121 0.0125" rpy="0 0 ${pi}"/>

</robot>
