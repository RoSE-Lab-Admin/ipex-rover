<?xml version="1.0" ?>
<!-- Sensor frames (no meshes): fixed joints from base_link.
     Positions are the mesh centers in the V1.3 CAD export (2026-10-31), moved
     +1.8 mm in x into this URDF's base_link frame (V1.3 centers base_link between
     the axles; this URDF's origin is 1.8 mm behind that). Update them when the
     V1.3 export with joints arrives. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sensor_frame" params="name parent xyz rpy">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- UM7 IMU (frame_id imu_link). Bench check (2026-10-31, tf_ned_to_enu on):
       rates follow the ROS convention, x forward / y left / z up, with the board
       held "forward" (still to confirm: its printed x arrow). rpy 0 assumes it is
       mounted with that arrow toward the front-arm end (+x); yaw ${pi} if toward
       the rear. -->
  <xacro:sensor_frame name="imu_link" parent="base_link"
                      xyz="-0.0565 0.0875 0.375" rpy="0 0 0"/>

  <!-- Intel RealSense D435 bodies (box centers), facing out of each end.
       The RealSense driver's own camera_link sits on the left imager, not the
       body center; attach it here with a fixed offset when the cameras go in. -->
  <xacro:sensor_frame name="front_camera_link" parent="base_link"
                      xyz="0.2839 -0.1093 0.2008" rpy="0 0 0"/>
  <xacro:sensor_frame name="rear_camera_link" parent="base_link"
                      xyz="-0.2811 0.1094 0.2008" rpy="0 0 ${pi}"/>

</robot>
