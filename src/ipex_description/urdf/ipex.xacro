<?xml version="1.0" ?>
<!-- Roxey geometry: IPEx CAD export V1.3 (with joints, received 2026-11-03),
     ported from "New URDF/IPEx_URDF_Export_V1.3_description". Changes from the
     export: package paths, includes (ros2_control + sensor frames instead of
     .trans/.gazebo), joint "back_right_wheel_rev (1)" renamed, and each
     shoulder joint pitched so position 0 = drum axle level with the pivot
     (the export has the arms raised: front 31.91 deg, rear 28.72 deg), and
     IMU_rigid turned 180 deg about z: the CAD avionics box is rotated, the
     real IMU is front-right, not rear-left.
     base_link: x forward (front arm end), y left, z up; origin midway
     between the axles, 0.1525 m below them (2.5 mm above the tire tread). -->
<robot name="full" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="materials.xacro" />
<xacro:include filename="ipex.ros2_control.xacro" />
<xacro:include filename="sensors.xacro" />
